+  String line=cursorRow<(int)lines.size()?lines[cursorRow]:String();
+  String context="Editor "+filePath+". Line "+String(cursorRow+1)+" of "+String(lines.size())+", column "+String(cursorCol+1)+". "+(modified?"Modified. ":"Saved. ")+(line.length()?line:"Blank line.");
+  if(changed){
+    String announcement=context;
+    if(lastFile==filePath&&row==cursorRow&&!Input::events().empty()){
+      const auto&key=Input::events().back();char typed=key.text();
+      if(typed)announcement=typed==' '?"Space":String(typed);
+      else if(key.isBackspace()||key.isDeleteForward())announcement="Deleted. "+line;
+      else if(!key.fn&&col!=cursorCol)announcement=cursorCol<(int)line.length()?(line[cursorCol]==' '?String("Space"):String(line[cursorCol]))+". Column "+String(cursorCol+1):String("End of line. Column ")+String(cursorCol+1);
+    }
+    static uint32_t revision=0;
+    Reader::focus("editor/"+String(readerSession)+"/"+String(++revision),announcement);
+    lastFile=filePath;row=cursorRow;col=cursorCol;dirty=modified;length=totalChars;session=readerSession;
+  }
+  Reader::context(context);
+#endif
+}
