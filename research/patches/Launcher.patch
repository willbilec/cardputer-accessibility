+#ifdef LAUNCHER_ACCESS_SPEECH
+    // Announce milestones, rather than every write, to keep speech usable.
+    static int lastMilestone = -1;
+    if (progress == 0) lastMilestone = -1;
+    if (total) {
+        int milestone = static_cast<int>((progress >= total ? 100 : (progress * 100ULL / total)) / 25);
